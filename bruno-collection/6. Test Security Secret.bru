meta {
  name: Test Security Secret
  type: http
  seq: 6
}

get {
  url: http://localhost:8080/api/v1/shipments
  body: none
  auth: none
}

tests {
  test("Response should be 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Investigation Code must be HIDDEN", function() {
    const expeditions = res.getBody();
    const firstExpedition = expeditions[0];
  
    expect(firstExpedition.investigationCode).to.be.undefined;
    expect(firstExpedition.investigation_code).to.be.undefined;
  
    expect(firstExpedition.destination_city).to.not.be.undefined;
  });
}
