meta {
  name: Get One Expedition
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/api/v1/expeditions/{{newId}}
  body: none
  auth: none
}

tests {
  test("Response status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("We got the correct expedition", function() {
    expect(res.getBody().destination).to.equal("Marseille");
  });
}