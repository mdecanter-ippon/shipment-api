meta {
  name: Get One Expedition
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/api/v1/shipments/{{newId}}
  body: none
  auth: none
}

vars:pre-request {
  newId: 24
}

tests {
  test("Response status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Data persistence check", function() {
    expect(res.getBody().destination_city).to.equal("Marseille");
    expect(res.getBody().shipping_date).to.equal("25-12-2023");
  });
}
