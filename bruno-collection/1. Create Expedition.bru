meta {
  name: Create Expedition
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/shipments
  body: json
  auth: none
}

body:json {
  {
    "destination_city": "Marseille",
    "weight_kg": 19.5,
    "status": "PENDING",
    "shipping_date": "25-12-2023"
  }
}

script:post-response {
  bru.setVar("newId", res.getBody().expedition_id);
}

tests {
  test("Response status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("JSON Contract Check", function() {
    const body = res.getBody();
  
    expect(body.destination_city).to.equal("Marseille");
    expect(body.weight_kg).to.equal(19.5);
  
    expect(body.shipping_date).to.equal("25-12-2023");
  
    expect(body.investigationCode).to.be.undefined;
    expect(body.investigation_code).to.be.undefined;
  });
}
