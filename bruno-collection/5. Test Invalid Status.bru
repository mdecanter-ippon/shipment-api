meta {
  name: Test Invalid Status
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/api/v1/shipments
  body: json
  auth: none
}

body:json {
  {
    "destination_city": "Bordeaux",
    "weight_kg": 5.0,
    "status": "FOO_INVALID_STATUS",
    "shipping_date": "25-12-2023"
  }
}

tests {
  test("Should return 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });
  
  test("Error should mention deserialization issue", function() {
    expect(res.getStatus()).to.not.equal(500);
  });
}
