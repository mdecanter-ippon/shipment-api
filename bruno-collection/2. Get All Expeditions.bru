meta {
  name: Get All Expeditions
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/api/v1/shipments
  body: none
  auth: none
}

tests {
  test("Response status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("List should not be empty", function() {
    expect(res.getBody().length).to.be.above(0);
  });
  
  test("First element has correct contract", function() {
    const firstItem = res.getBody()[0];
    expect(firstItem.expedition_id).to.not.be.undefined;
    expect(firstItem.destination_city).to.not.be.undefined;
  });
}
