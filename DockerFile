# --- Stage 1: The Build Stage ---
# Use a Maven image with Java 21 to build the application
FROM maven:3.9.7-eclipse-temurin-21 AS builder
# Set the working directory
WORKDIR /app
# Copy the Maven project file first to cache dependencies
COPY pom.xml .
RUN mvn dependency:go-offline
# Copy the source code and build the application
COPY src ./src
# -DskipTests for a fast build in a Docker context
RUN mvn clean package -DskipTests

# --- Stage 2: Runtime Stage ---
# Use a lightweight JRE image (Java 21)
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
# Argument to find the JAR file
# This wildcard (*) is safer if you change the version in pom.xml
ARG JAR_FILE=target/*.jar
# Copy the built JAR from the 'builder' stage
COPY --from=builder /app/${JAR_FILE} app.jar
# Expose the port Spring Boot runs on
EXPOSE 8080
# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]